diff --git a/prime-mobile-os/app/Domain/Notifications/Services/NotificationCenter.php b/prime-mobile-os/app/Domain/Notifications/Services/NotificationCenter.php
new file mode 100644
index 0000000..d27e488
--- /dev/null
+++ b/prime-mobile-os/app/Domain/Notifications/Services/NotificationCenter.php
@@ -0,0 +1,67 @@
+<?php
+
+namespace App\Domain\Notifications\Services;
+
+use App\Domain\Approvals\Services\ApprovalQueries;
+use App\Domain\Notifications\Models\AppNotification;
+use App\Models\User;
+use Illuminate\Support\Collection;
+
+/**
+ * API of the bell (TZ 04 Э28.1) for Livewire / Filament: tabs «Заявки (2)» · «Уведомления» · «Мои заявки».
+ * Everything is scoped to the current organization and to the given user; ids from the browser are checked here.
+ *
+ *   $center->bell($user)          // ['approvals' => 2, 'notifications' => 5, 'my_requests' => 1, 'badge' => 7]
+ *   $center->latest($user, 30)    // Collection of AppNotification (->toBell() for the row)
+ *   $center->markRead($user, $id); $center->markAllRead($user);
+ */
+class NotificationCenter
+{
+    public function __construct(private readonly ApprovalQueries $approvals) {}
+
+    /** @return array{approvals: int, notifications: int, my_requests: int, badge: int} */
+    public function bell(User $user): array
+    {
+        $approvals = $this->approvals->awaitingCount($user);
+        $notifications = $this->unreadCount($user);
+
+        return [
+            'approvals' => $approvals,
+            'notifications' => $notifications,
+            'my_requests' => $this->approvals->mineOpenCount($user),
+            'badge' => $approvals + $notifications,
+        ];
+    }
+
+    public function unreadCount(User $user): int
+    {
+        return AppNotification::query()->where('user_id', $user->id)->whereNull('read_at')->count();
+    }
+
+    /** @return Collection<int, AppNotification> */
+    public function latest(User $user, int $limit = 30, bool $unreadOnly = false): Collection
+    {
+        return AppNotification::query()->where('user_id', $user->id)
+            ->when($unreadOnly, fn ($q) => $q->whereNull('read_at'))
+            ->orderByDesc('id')->limit(max(1, min($limit, 100)))->get();
+    }
+
+    /** Marks one own notification read; another user's id (forged in the browser) is ignored. */
+    public function markRead(User $user, int $notificationId): bool
+    {
+        return AppNotification::query()->whereKey($notificationId)->where('user_id', $user->id)->whereNull('read_at')
+            ->update(['read_at' => now(), 'updated_at' => now()]) > 0;
+    }
+
+    public function markAllRead(User $user): int
+    {
+        return AppNotification::query()->where('user_id', $user->id)->whereNull('read_at')->update(['read_at' => now(), 'updated_at' => now()]);
+    }
+
+    /** Mark read the notifications about one approval request (the user opened its card). */
+    public function markReadForRequest(User $user, int $requestId): int
+    {
+        return AppNotification::query()->where('user_id', $user->id)->where('approval_request_id', $requestId)->whereNull('read_at')
+            ->update(['read_at' => now(), 'updated_at' => now()]);
+    }
+}
diff --git a/prime-mobile-os/app/Domain/Notifications/Services/NotificationPreferences.php b/prime-mobile-os/app/Domain/Notifications/Services/NotificationPreferences.php
new file mode 100644
index 0000000..33f4471
--- /dev/null
+++ b/prime-mobile-os/app/Domain/Notifications/Services/NotificationPreferences.php
@@ -0,0 +1,65 @@
+<?php
+
+namespace App\Domain\Notifications\Services;
+
+use App\Domain\Notifications\Enums\NotificationType;
+use App\Domain\Notifications\Models\NotificationPreference;
+use App\Models\User;
+
+/**
+ * «Что присылать» (TZ 04 Э26 «Уведомления», TZ 06 §4.1 «каждую сводку можно выключить»): channels per user and
+ * notification type. In-app (the bell) cannot be switched off for approvals — a request must never be lost.
+ *
+ *   $prefs->channels($owner, NotificationType::BigDiscount)  // ['in_app' => true, 'push' => true, 'telegram' => false]
+ *   $prefs->set($owner, NotificationType::BigDiscount, push: false, telegram: true);
+ */
+class NotificationPreferences
+{
+    /** @return array{in_app: bool, push: bool, telegram: bool} */
+    public function channels(User|int $user, NotificationType $type): array
+    {
+        $row = NotificationPreference::query()->where('user_id', $this->id($user))->where('type', $type->value)->first();
+        $defaults = ['in_app' => true, 'push' => $type->defaultPush(), 'telegram' => $type->defaultTelegram()];
+        if (! $row) {
+            return $defaults;
+        }
+
+        return [
+            'in_app' => $this->alwaysInApp($type) ? true : (bool) $row->in_app,
+            'push' => (bool) $row->push,
+            'telegram' => (bool) $row->telegram,
+        ];
+    }
+
+    /** @return array<string, array{label: string, in_app: bool, push: bool, telegram: bool}> owner settings table */
+    public function table(User|int $user): array
+    {
+        $out = [];
+        foreach (NotificationType::ownerConfigurable() as $type) {
+            $out[$type->value] = ['label' => $type->label()] + $this->channels($user, $type);
+        }
+
+        return $out;
+    }
+
+    public function set(User|int $user, NotificationType $type, bool $push, bool $telegram, bool $inApp = true): NotificationPreference
+    {
+        $row = NotificationPreference::query()->updateOrCreate(
+            ['user_id' => $this->id($user), 'type' => $type->value],
+            ['in_app' => $this->alwaysInApp($type) ? true : $inApp, 'push' => $push, 'telegram' => $telegram],
+        );
+        activity('settings')->performedOn($row)->withProperties(['type' => $type->value, 'push' => $push, 'telegram' => $telegram])->log('notification_preference');
+
+        return $row;
+    }
+
+    private function alwaysInApp(NotificationType $type): bool
+    {
+        return in_array($type, [NotificationType::ApprovalNew, NotificationType::ApprovalEscalated, NotificationType::ApprovalDecided], true);
+    }
+
+    private function id(User|int $user): int
+    {
+        return $user instanceof User ? $user->id : $user;
+    }
+}
diff --git a/prime-mobile-os/app/Domain/Notifications/Services/Notifier.php b/prime-mobile-os/app/Domain/Notifications/Services/Notifier.php
