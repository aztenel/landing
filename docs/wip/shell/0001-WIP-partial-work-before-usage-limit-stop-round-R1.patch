+<?php
+
+namespace App\Domain\Shell\Services;
+
+use App\Domain\Tenancy\Access\Exceptions\AccessDenied;
+use App\Domain\Tenancy\Access\Limit;
+use App\Domain\Tenancy\Access\PermissionCatalog;
+use App\Domain\Tenancy\Access\RoleTemplates;
+use App\Domain\Tenancy\Models\Membership;
+use App\Domain\Tenancy\Models\RoleLimit;
+use App\Models\User;
+use App\Support\Exceptions\UserFacingException;
+use App\Support\Tenancy\CurrentOrganization;
+use App\Support\Ui\Access;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+use Spatie\Permission\Models\Role;
+use Spatie\Permission\PermissionRegistrar;
+
+/**
+ * Roles of the firm with the permission matrix and limits (TZ 03 §16, TZ 04 Э25.2).
+ *
+ * State of a permission in a role: off · on · «только заявкой» (role_limits[perm] = 0).
+ * Limits L1…L18 are shown under the permission they limit (LIMIT_OF); empty = ∞, 0 = always approval.
+ */
+class RoleEditor
+{
+    /** Which permission a limit belongs to (for the matrix screen). */
+    public const LIMIT_OF = [
+        'L1' => 'sale.discount', 'L2' => 'sale.discount', 'L3' => 'sale.discount',
+        'L4' => 'sale.credit', 'L5' => 'sale.credit', 'L6' => 'sale.credit',
+        'L7' => 'return.accessory', 'L8' => 'return.phone', 'L9' => 'return.phone',
+        'L10' => 'expense.create', 'L11' => 'expense.create',
+        'L12' => 'tradein.buyout', 'L13' => 'tradein.over_grid', 'L14' => 'price.edit',
+        'L15' => 'stock.write_off', 'L16' => 'money.adjust', 'L17' => 'bonus.manual', 'L18' => 'doc.reverse',
+    ];
+
+    /** One line in plain words under a permission (TZ 04 Э25.2). */
+    public const HINTS = [
+        'sale.create' => 'Касса: скан, корзина, оплата, чек',
+        'sale.discount' => 'Сверх лимита сотрудник отправит заявку вам на телефон',
+        'sale.below_cost' => 'Цена ниже себестоимости — только с вашего разрешения',
+        'sale.credit' => 'Общий долг клиента после продажи не больше лимита',
+        'sale.no_imei_check' => 'Закон запрещает продавать телефон без отметки госбазы',
+        'return.phone' => 'Возврат денег покупателю за телефон',
+        'stock.receive' => 'Приход телефонов сканером IMEI',
+        'stock.cost_edit' => 'Цена закупа в приходе',
+        'stock.write_off' => 'Сверх лимита — заявка',
+        'price.edit' => 'Изменение больше лимита — заявка',
+        'expense.create' => 'Расход из кассы магазина',
+        'rate.set' => 'Курс $ для всех операций фирмы',
+        'doc.reverse' => 'Отмена проведённого документа обратными записями',
+        'doc.backdate' => 'До 3 дней назад, с причиной, не в закрытом месяце',
+        'approval.decide' => 'Только в пределах собственных лимитов',
+        'staff.manage' => 'Только владелец',
+        'role.manage' => 'Только владелец',
+        'audit.view' => 'Кто, что и когда сделал',
+        'stock.view_cost' => 'Без этого сотрудник не увидит себестоимость нигде: ни в складе, ни в отчётах, ни в Excel',
+        'stock.view_supplier' => 'Поставщик, курс и валюта закупа телефона',
+        'profit.view' => 'Прибыль и наценка в чеках, отчётах и на статистике',
+        'customer.view_iin' => 'Без этого — только последние 4 цифры',
+        'money.view_bank_balances' => 'Остатки Kaspi, банка и терминала',
+        'customer.export' => 'Выгрузка базы клиентов в Excel',
+        'report.export' => 'Выгрузка отчётов в Excel',
+    ];
+
+    /**
+     * @return list<array{key: string, title: string, items: list<array{code: string, title: string, hint: ?string, on: bool, approval: bool, limits: list<array{code: string, title: string, unit: string, value: ?int}>}>}>
+     */
+    public function matrix(Role $role): array
+    {
+        $granted = $role->permissions()->pluck('name')->flip();
+        $limits = RoleLimit::query()->where('role_id', $role->id)->pluck('value', 'code');
+        $groups = [];
+        foreach (PermissionCatalog::GROUPS as $key => $title) {
+            $groups[$key] = ['key' => $key, 'title' => $title, 'items' => []];
+        }
+        foreach (PermissionCatalog::MATRIX as $code => $row) {
+            $limitRows = [];
+            foreach (self::LIMIT_OF as $lCode => $perm) {
+                if ($perm === $code) {
+                    $limit = Limit::from($lCode);
+                    $limitRows[] = [
+                        'code' => $lCode, 'title' => $limit->title(), 'unit' => $limit->unit(),
+                        'value' => $limits->has($lCode) ? $limits[$lCode] : null,
+                    ];
+                }
+            }
+            $groups[$row[0]]['items'][] = [
+                'code' => $code,
+                'title' => $row[1],
+                'hint' => self::HINTS[$code] ?? null,
+                'on' => $role->is_owner || $granted->has($code),
+                'approval' => ! $role->is_owner && $limits->has($code) && (int) $limits[$code] === 0,
+                'limits' => $limitRows,
+            ];
+        }
+
+        return array_values($groups);
+    }
+
+    /**
+     * Save switches and limits of a role. $state: [code => ['on' => bool, 'approval' => bool]],
+     * $limitValues: ['L1' => int|null] in storage units (tiyn, percent ×100, days).
+     *
+     * @return int how many members got the change
+     */
+    public function save(Role $role, array $state, array $limitValues, User $by): int
+    {
+        Access::authorize('role.manage', __('Роли меняет только владелец'), user: $by);
+        $this->assertOwnFirm($role);
+        if ($role->is_owner) {
+            throw UserFacingException::because('owner_role', __('Роль «Владелец» не редактируется: у неё все права без лимитов'));
+        }
+        if ($this->roleOfUser($by)?->is($role)) {
+            throw UserFacingException::because('own_role', __('Свою роль менять нельзя'));
+        }
+        $byIsOwner = Access::isOwner($by);
+        $granted = [];
+        $approvalOnly = [];
+        foreach (PermissionCatalog::codes() as $code) {
+            $s = $state[$code] ?? ['on' => false];
+            if (! ($s['on'] ?? false)) {
+                continue;
+            }
+            // Nobody hands out a right he does not have himself (TZ 03 §16.2 p.3).
+            if (! $byIsOwner && ! Access::sees($code, $by)) {
+                throw AccessDenied::because('access_denied', __('Нельзя выдать право, которого нет у вас: :p', ['p' => PermissionCatalog::title($code)]));
+            }
+            $granted[] = $code;
+            if ($s['approval'] ?? false) {
+                $approvalOnly[] = $code;
+            }
+        }
+
+        return DB::transaction(function () use ($role, $granted, $approvalOnly, $limitValues, $by) {
+            $before = $this->summary($role);
+            $role->syncPermissions($granted);
+            RoleLimit::query()->where('role_id', $role->id)->delete();
+            $rows = [];
+            $now = now();
+            foreach (Limit::cases() as $limit) {
+                $value = array_key_exists($limit->value, $limitValues) ? $limitValues[$limit->value] : null;
+                $rows[] = ['organization_id' => $role->organization_id, 'role_id' => $role->id, 'code' => $limit->value,
+                    'value' => $value === null ? null : max(0, (int) $value), 'created_at' => $now, 'updated_at' => $now];
+            }
+            foreach ($approvalOnly as $code) {
+                $rows[] = ['organization_id' => $role->organization_id, 'role_id' => $role->id, 'code' => $code,
+                    'value' => 0, 'created_at' => $now, 'updated_at' => $now];
+            }
+            DB::table('role_limits')->insert($rows);
+            app(PermissionRegistrar::class)->forgetCachedPermissions();
+            Access::instance()->flush();
+            $after = $this->summary($role->refresh());
+            AuditLog::record('settings', 'role_saved', $role, [
+                'role' => $role->title,
+                'added' => array_values(array_diff($after['permissions'], $before['permissions'])),
+                'removed' => array_values(array_diff($before['permissions'], $after['permissions'])),
+                'old' => $before['limits'], 'new' => $after['limits'],
+            ], $by);
+
+            return $this->membersCount($role);
+        });
+    }
+
+    /** «Новая роль» on the basis of an existing one (empty roles are not created, TZ 03 §16.2 p.1). */
+    public function create(string $title, Role $basedOn, User $by): Role
+    {
+        Access::authorize('role.manage', __('Роли создаёт только владелец'), user: $by);
+        $this->assertOwnFirm($basedOn);
+        $title = trim($title);
+        if (mb_strlen($title) < 2 || mb_strlen($title) > 60) {
+            throw UserFacingException::because('title', __('Название роли — от 2 до 60 символов'));
+        }
+        $orgId = CurrentOrganization::instance()->requireId();
+        if (Role::query()->where('organization_id', $orgId)->whereRaw('lower(title) = ?', [mb_strtolower($title)])->exists()) {
+            throw UserFacingException::because('title', __('Роль с таким названием уже есть'));
+        }
+
+        return DB::transaction(function () use ($title, $basedOn, $orgId, $by) {
+            $role = Role::query()->create([
+                'name' => 'custom_'.Str::lower(Str::random(8)),
+                'guard_name' => 'web',
+                'organization_id' => $orgId,
+                'title' => $title,
+                'is_owner' => false,
+                'description' => __('на основе роли «:role»', ['role' => $basedOn->title]),
+            ]);
+            $role->syncPermissions($basedOn->is_owner ? PermissionCatalog::codes() : $basedOn->permissions()->pluck('name')->all());
+            if (! $basedOn->is_owner) {
+                $rows = RoleLimit::query()->where('role_id', $basedOn->id)->get()->map(fn (RoleLimit $l) => [
+                    'organization_id' => $orgId, 'role_id' => $role->id, 'code' => $l->code, 'value' => $l->value,
+                    'created_at' => now(), 'updated_at' => now(),
+                ])->all();
+                DB::table('role_limits')->insert($rows);
+            }
+            app(PermissionRegistrar::class)->forgetCachedPermissions();
+            AuditLog::record('settings', 'role_created', $role, ['role' => $title, 'based_on' => $basedOn->title], $by);
+
+            return $role;
+        });
+    }
+
+    public function delete(Role $role, User $by): void
+    {
+        Access::authorize('role.manage', __('Роли удаляет только владелец'), user: $by);
+        $this->assertOwnFirm($role);
+        if ($role->is_owner) {
+            throw UserFacingException::because('owner_role', __('Роль «Владелец» удалить нельзя'));
+        }
+        $count = $this->membersCount($role, true);
+        if ($count > 0) {
+            throw UserFacingException::because('role_in_use', trans_choice('На роли :count сотрудник. Сначала переведите его на другую роль|На роли :count сотрудника. Сначала переведите их на другую роль|На роли :count сотрудников. Сначала переведите их на другую роль', $count, ['count' => $count]));
+        }
+        $title = $role->title;
+        $role->delete();
+        app(PermissionRegistrar::class)->forgetCachedPermissions();
+        AuditLog::record('settings', 'role_deleted', null, ['role' => $title], $by);
+    }
+
+    public function membersCount(Role $role, bool $includeBlocked = false): int
+    {
+        $userIds = DB::table('model_has_roles')->where('role_id', $role->id)->where('organization_id', $role->organization_id)->pluck('model_id');
+        $q = Membership::query()->whereIn('user_id', $userIds);
+        $q->whereIn('status', $includeBlocked ? ['active', 'invited', 'blocked'] : ['active']);
+
+        return $q->count();
+    }
+
+    /** @return list<Role> roles of the current firm, owner first, then the templates in their order */
+    public function roles(): array
+    {
+        $order = array_flip(RoleTemplates::codes());
+
+        return Role::query()->where('organization_id', CurrentOrganization::instance()->requireId())->get()
+            ->sortBy(fn (Role $r) => [$order[$r->name] ?? 100, $r->id])->values()->all();
+    }
+
+    private function assertOwnFirm(Role $role): void
+    {
+        if ((int) $role->organization_id !== CurrentOrganization::instance()->requireId()) {
+            throw AccessDenied::because('access_denied', __('Роль не найдена в этой фирме'));
+        }
+    }
+
+    private function roleOfUser(User $user): ?Role
+    {
+        $user->unsetRelation('roles');
+
+        return $user->roles()->first();
+    }
+
+    /** @return array{permissions: list<string>, limits: array<string, ?int>} */
+    private function summary(Role $role): array
+    {
+        return [
+            'permissions' => $role->permissions()->pluck('name')->sort()->values()->all(),
+            'limits' => RoleLimit::query()->where('role_id', $role->id)->orderBy('code')->pluck('value', 'code')->all(),
+        ];
+    }
+}
diff --git a/prime-mobile-os/app/Domain/Shell/Services/ScreenLock.php b/prime-mobile-os/app/Domain/Shell/Services/ScreenLock.php
new file mode 100644
index 0000000..312d6f2
--- /dev/null
+++ b/prime-mobile-os/app/Domain/Shell/Services/ScreenLock.php
@@ -0,0 +1,104 @@
+<?php
+
+namespace App\Domain\Shell\Services;
+
+use App\Domain\Shell\Enums\DeviceType;
+use App\Domain\Shell\Models\Device;
+use App\Models\User;
+use App\Support\Tenancy\CurrentOrganization;
+use App\Support\Ui\Access;
+use Illuminate\Contracts\Session\Session;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Hash;
+
+/**
+ * Screen lock after idle (TZ 04 Э1.3, TZ 03 §9). The session stays alive (cart, drafts), the page is closed
+ * until the password is entered again. The browser counts idle time and asks the server to lock; the server
+ * checks it too (time of the last activity in the session), so a stopped script does not keep a screen open.
+ *
+ * Timeouts (minutes, settings «Безопасность»): store computer 10, iPhone 5, laptop of admin/accountant/owner 15.
+ * Full logout: laptops after 12 h, iPhone of the owner after 7 days (TZ 03 §9).
+ */
+class ScreenLock
+{
+    public const LOCKED = 'shell.locked_at';
+
+    public const ACTIVE = 'shell.active_at';
+
+    public const LOGIN_AT = 'shell.login_at';
+
+    public const FAILS = 'shell.unlock_fails';
+
+    public function timeoutMinutes(User $user, ?Device $device, Request $request): int
+    {
+        $settings = CurrentOrganization::instance()->get()?->settings();
+        $get = fn (string $key, int $default) => max(1, (int) ($settings?->get('security.'.$key) ?? $default));
+
+        if (DeviceRegistry::isPhone((string) $request->userAgent())) {
+            return $get('lock_iphone', (int) config('prime.lock.iphone', 5));
+        }
+        if ($device?->type === DeviceType::StoreComputer || ! Access::sees(['org.settings', 'report.dashboard', 'money.accounts'], $user)) {
+            return $get('lock_store_computer', (int) config('prime.lock.store_computer', 10));
+        }
+
+        return $get('lock_laptop', (int) config('prime.lock.laptop', 15));
+    }
+
+    public function maxSessionHours(User $user, Request $request): int
+    {
+        return DeviceRegistry::isPhone((string) $request->userAgent()) && Access::isOwner($user) ? 24 * 7 : 12;
+    }
+
+    public function isLocked(Session $session): bool
+    {
+        return (bool) $session->get(self::LOCKED);
+    }
+
+    public function lock(Session $session, User $user, string $why = 'idle'): void
+    {
+        if (! $this->isLocked($session)) {
+            $session->put(self::LOCKED, now()->getTimestamp());
+            AuditLog::record('auth', 'lock', null, ['why' => $why], $user);
+        }
+    }
+
+    /** @return bool true = unlocked; false = wrong password (after 5 → the caller logs out) */
+    public function unlock(Session $session, User $user, string $password): bool
+    {
+        if (! Hash::check($password, $user->getAuthPassword())) {
+            $session->put(self::FAILS, (int) $session->get(self::FAILS, 0) + 1);
+
+            return false;
+        }
+        $session->forget([self::LOCKED, self::FAILS]);
+        $session->put(self::ACTIVE, now()->getTimestamp());
+        AuditLog::record('auth', 'unlock', null, [], $user);
+
+        return true;
+    }
+
+    public function failures(Session $session): int
+    {
+        return (int) $session->get(self::FAILS, 0);
+    }
+
+    public function touch(Session $session): void
+    {
+        $session->put(self::ACTIVE, now()->getTimestamp());
+    }
+
+    /** Idle longer than the timeout (+30 s for the browser warning) → lock. */
+    public function isIdleTooLong(Session $session, int $minutes): bool
+    {
+        $active = (int) $session->get(self::ACTIVE, 0);
+
+        return $active > 0 && now()->getTimestamp() - $active > $minutes * 60 + (int) config('prime.lock.warning_seconds', 30);
+    }
+
+    public function isSessionTooOld(Session $session, int $hours): bool
+    {
+        $login = (int) $session->get(self::LOGIN_AT, 0);
+
+        return $login > 0 && now()->getTimestamp() - $login > $hours * 3600;
+    }
+}
diff --git a/prime-mobile-os/app/Domain/Shell/Services/StaffManager.php b/prime-mobile-os/app/Domain/Shell/Services/StaffManager.php
new file mode 100644
index 0000000..f5c6734
--- /dev/null
+++ b/prime-mobile-os/app/Domain/Shell/Services/StaffManager.php
@@ -0,0 +1,422 @@
+<?php
+
+namespace App\Domain\Shell\Services;
+
+use App\Domain\Shell\Enums\DeviceStatus;
+use App\Domain\Shell\Models\Device;
+use App\Domain\Shell\Models\Invitation;
+use App\Domain\Tenancy\Access\AccessChecker;
+use App\Domain\Tenancy\Access\Exceptions\AccessDenied;
+use App\Domain\Tenancy\Access\Limit;
+use App\Domain\Tenancy\Enums\MembershipStatus;
+use App\Domain\Tenancy\Models\Membership;
+use App\Domain\Tenancy\Models\Store;
+use App\Models\User;
+use App\Support\Exceptions\UserFacingException;
+use App\Support\Phone\Phone;
+use App\Support\Tenancy\CurrentOrganization;
+use App\Support\Ui\Access;
+use Closure;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Str;
+use InvalidArgumentException;
+use Spatie\Permission\Models\Role;
+use Spatie\Permission\PermissionRegistrar;
+
+/**
+ * Staff of the firm (TZ 03 §14–15, TZ 04 Э25.1): invite, change, block, dismiss, restore, reset password.
+ * Every method checks the right of the actor on the server and writes the action journal.
+ *
+ * Other modules add checks shown before a dismissal (open shift, orders with prepayment…):
+ *   StaffManager::addDismissalCheck(fn (Membership $m): ?string => $hasOpenShift ? __('Открыта смена…') : null);
+ */
+class StaffManager
+{
+    /** @var list<Closure(Membership): ?string> */
+    private static array $dismissalChecks = [];
+
+    public function __construct(private readonly AccessChecker $checker) {}
+
+    public static function addDismissalCheck(Closure $check): void
+    {
+        self::$dismissalChecks[] = $check;
+    }
+
+    /** @return list<string> warnings to confirm before dismissing (none forbids the dismissal, TZ 03 §15.2) */
+    public function dismissalWarnings(Membership $membership): array
+    {
+        return array_values(array_filter(array_map(fn (Closure $c) => $c($membership), self::$dismissalChecks)));
+    }
+
+    /**
+     * Invite a person (TZ 03 §14). Existing user (other firm) keeps the password; a dismissed member of this
+     * firm must be restored instead.
+     *
+     * @param  array{name: string, phone: string, role_id: int, store_ids: list<int>, store_flags?: array, limits?: array, payroll?: array, started_on?: ?string}  $data
+     * @return array{membership: Membership, url: string}
+     */
+    public function invite(array $data, User $by): array
+    {
+        Access::authorize('staff.manage', __('Приглашать сотрудников может владелец'), user: $by);
+        $phone = $this->phone($data['phone']);
+        $name = trim($data['name']);
+        if (mb_strlen($name) < 2 || mb_strlen($name) > 60) {
+            throw UserFacingException::because('name', __('Имя и фамилия — от 2 до 60 символов'));
+        }
+        $role = $this->role((int) $data['role_id'], $by);
+        $storeIds = $this->stores($data['store_ids'] ?? []);
+
+        return DB::transaction(function () use ($data, $phone, $name, $role, $storeIds, $by) {
+            $user = User::query()->where('phone', $phone)->first();
+            if ($user) {
+                $existing = Membership::query()->where('user_id', $user->id)->first();
+                if ($existing && $existing->status === MembershipStatus::Dismissed) {
+                    throw UserFacingException::because('dismissed', __('Этот человек уволен из фирмы. Восстановите его в списке сотрудников — история продаж та же'));
+                }
+                if ($existing) {
+                    throw UserFacingException::because('exists', __('Этот сотрудник уже есть в списке'));
+                }
+            } else {
+                $user = new User;
+                $user->forceFill(['phone' => $phone, 'name' => $name, 'password' => Hash::make(Str::random(40))])->save();
+            }
+
+            $membership = new Membership;
+            $membership->forceFill([
+                'user_id' => $user->id,
+                'status' => MembershipStatus::Invited,
+                'store_ids' => $storeIds,
+                'store_flags' => $this->flags($storeIds, $data['store_flags'] ?? []),
+                'limits' => $this->limits($data['limits'] ?? []) ?: new \stdClass,
+                'payroll' => $this->payroll($data['payroll'] ?? []) ?: new \stdClass,
+                'position' => $role->title,
+                'started_on' => $data['started_on'] ?? null,
+                'invited_at' => now(),
+                'created_by' => $by->id,
+            ])->save();
+            $this->assignRole($user, $role);
+            $url = $this->issueLink($membership, Invitation::INVITE, $by);
+            AuditLog::record('settings', 'member_invited', $membership, ['name' => $name, 'role' => $role->title], $by);
+
+            return ['membership' => $membership, 'url' => $url];
+        });
+    }
+
+    /** @param array{name?: string, role_id?: int, store_ids?: list<int>, store_flags?: array, limits?: array, payroll?: array} $data */
+    public function update(Membership $membership, array $data, User $by): Membership
+    {
+        Access::authorize('staff.manage', __('Менять сотрудников может владелец'), user: $by);
+        $user = $membership->user;
+        if ($user->is($by) && isset($data['role_id']) && $this->roleOf($user)?->id !== (int) $data['role_id']) {
+            throw UserFacingException::because('own_role', __('Свою роль менять нельзя'));
+        }
+
+        return DB::transaction(function () use ($membership, $data, $by, $user) {
+            $old = $this->snapshot($membership);
+            if (isset($data['role_id'])) {
+                $role = $this->role((int) $data['role_id'], $by);
+                $current = $this->roleOf($user);
+                if ($current?->is_owner && ! $role->is_owner) {
+                    $this->assertNotLastOwner($membership);
+                }
+                $this->assignRole($user, $role);
+                $membership->position = $role->title;
+            }
+            if (isset($data['name']) && trim($data['name']) !== '') {
+                $user->forceFill(['name' => trim($data['name'])])->save();
+            }
+            if (array_key_exists('store_ids', $data)) {
+                $storeIds = $this->stores($data['store_ids']);
+                $membership->store_ids = $storeIds;
+                $membership->store_flags = $this->flags($storeIds, $data['store_flags'] ?? []);
+            }
+            if (array_key_exists('limits', $data)) {
+                $membership->limits = $this->limits($data['limits']) ?: new \stdClass;
+            }
+            if (array_key_exists('payroll', $data)) {
+                $membership->payroll = $this->payroll($data['payroll']) ?: new \stdClass;
+            }
+            $membership->save();
+            Access::instance()->flush();
+            AuditLog::record('settings', 'member_updated', $membership, [
+                'name' => $user->name, 'old' => $old, 'new' => $this->snapshot($membership->refresh()),
+            ], $by);
+
+            return $membership;
+        });
+    }
+
+    public function block(Membership $membership, ?string $reason, User $by): Membership
+    {
+        Access::authorize('staff.dismiss', __('Блокирует сотрудников владелец'), user: $by);
+        $this->assertNotSelf($membership, $by);
+        $this->assertNotLastOwner($membership);
+        $membership->forceFill(['status' => MembershipStatus::Blocked, 'blocked_reason' => $reason, 'blocked_at' => now()])->save();
+        $this->closeSessions($membership->user);
+        $this->revokeLinks($membership);
+        AuditLog::record('settings', 'member_blocked', $membership, ['name' => $membership->user->name, 'reason' => $reason], $by);
+
+        return $membership;
+    }
+
+    public function unblock(Membership $membership, User $by): Membership
+    {
+        Access::authorize('staff.dismiss', __('Разблокирует сотрудников владелец'), user: $by);
+        $membership->forceFill(['status' => MembershipStatus::Active, 'blocked_reason' => null, 'blocked_at' => null])->save();
+        AuditLog::record('settings', 'member_unblocked', $membership, ['name' => $membership->user->name], $by);
+
+        return $membership;
+    }
+
+    public function dismiss(Membership $membership, ?string $reason, User $by): Membership
+    {
+        Access::authorize('staff.dismiss', __('Увольняет сотрудников владелец'), user: $by);
+        $this->assertNotSelf($membership, $by);
+        $this->assertNotLastOwner($membership);
+
+        return DB::transaction(function () use ($membership, $reason, $by) {
+            $membership->forceFill(['status' => MembershipStatus::Dismissed, 'dismissed_at' => now(), 'dismissal_reason' => $reason])->save();
+            $this->closeSessions($membership->user);
+            $this->revokeLinks($membership);
+            // Personal devices of the person are switched off (TZ 03 §15.2 p.4).
+            Device::query()->where('owner_user_id', $membership->user_id)->where('status', '!=', DeviceStatus::Disabled->value)
+                ->get()->each(fn (Device $d) => $d->forceFill(['status' => DeviceStatus::Disabled->value, 'disabled_by' => $by->id, 'disabled_at' => now()])->save());
+            AuditLog::record('settings', 'member_dismissed', $membership, ['name' => $membership->user->name, 'reason' => $reason], $by);
+
+            return $membership;
+        });
+    }
+
+    /** «Восстановить»: active again with the same role and stores; devices must be allowed again (TZ 03 §15.2). */
+    public function restore(Membership $membership, User $by): Membership
+    {
+        Access::authorize('staff.manage', __('Восстанавливает сотрудников владелец'), user: $by);
+        $membership->forceFill(['status' => MembershipStatus::Active, 'dismissed_at' => null, 'dismissal_reason' => null])->save();
+        AuditLog::record('settings', 'member_restored', $membership, ['name' => $membership->user->name], $by);
+
+        return $membership;
+    }
+
+    /** New one-time link (invitation again or password reset, TZ 03 §7.5) — old links stop working. */
+    public function passwordLink(Membership $membership, User $by): string
+    {
+        Access::authorize('staff.manage', __('Пароль сбрасывает владелец'), user: $by);
+        $kind = $membership->status === MembershipStatus::Invited ? Invitation::INVITE : Invitation::PASSWORD_RESET;
+        $url = $this->issueLink($membership, $kind, $by);
+        AuditLog::record('settings', 'password_reset_link', $membership, ['name' => $membership->user->name], $by);
+
+        return $url;
+    }
+
+    /** «Выйти везде» for a person: the owner for anybody, the person — for himself (TZ 03 §8.4). */
+    public function logoutEverywhere(Membership $membership, User $by): void
+    {
+        if (! $membership->user->is($by)) {
+            Access::authorize('staff.manage', __('Закрыть сессии другого сотрудника может владелец'), user: $by);
+        }
+        $this->closeSessions($membership->user);
+        AuditLog::record('settings', 'sessions_closed', $membership, ['name' => $membership->user->name], $by);
+    }
+
+    /** Open link: the invitation of this firm by its token (null = unknown / expired / used). */
+    public static function findLink(string $token): ?Invitation
+    {
+        return Invitation::query()->withoutGlobalScopes()->where('token_hash', Invitation::hashToken($token))->first();
+    }
+
+    /**
+     * Accept an invitation / set a new password by the link (TZ 03 §14.2, Э1.2). Activates the membership.
+     */
+    public function accept(Invitation $invitation, string $password, bool $rulesAccepted, ?int $rulesVersion = null): User
+    {
+        if (! $invitation->isUsable()) {
+            throw UserFacingException::because('link_expired', __('Приглашение устарело. Попросите владельца отправить новое'));
+        }
+        $user = $invitation->user;
+        PasswordRules::assert($password, $user->phone);
+        if (! $rulesAccepted) {
+            throw UserFacingException::because('rules', __('Подтвердите, что прочитали правила работы с данными клиентов'));
+        }
+
+        return CurrentOrganization::instance()->run($invitation->organization_id, function () use ($invitation, $password, $rulesVersion, $user) {
+            return DB::transaction(function () use ($invitation, $password, $rulesVersion, $user) {
+                $user->forceFill(['password' => Hash::make($password), 'must_change_password' => false, 'password_changed_at' => now()])->save();
+                $membership = $invitation->membership;
+                $attrs = ['rules_accepted_at' => now(), 'rules_version' => $rulesVersion];
+                if ($membership->status === MembershipStatus::Invited) {
+                    $attrs += ['status' => MembershipStatus::Active, 'accepted_at' => now()];
+                }
+                $membership->forceFill($attrs)->save();
+                $invitation->forceFill(['used_at' => now()])->save();
+                Invitation::query()->where('membership_id', $membership->id)->whereNull('used_at')->whereNull('revoked_at')
+                    ->update(['revoked_at' => now()]);
+                $this->closeSessions($user);
+                AuditLog::record('auth', $invitation->kind === Invitation::INVITE ? 'invitation_accepted' : 'password_changed', $membership, [], $user);
+
+                return $user;
+            });
+        });
+    }
+
+    public function roleOf(User $user): ?Role
+    {
+        $user->unsetRelation('roles');
+
+        /** @var Role|null */
+        return $user->roles()->first();
+    }
+
+    public function closeSessions(User $user): void
+    {
+        if (config('session.driver') === 'database') {
+            DB::table(config('session.table', 'sessions'))->where('user_id', $user->id)->delete();
+        }
+        $user->forceFill(['remember_token' => Str::random(60)])->save();
+    }
+
+    private function issueLink(Membership $membership, string $kind, User $by): string
+    {
+        $this->revokeLinks($membership);
+        $token = Str::random(48);
+        $hours = $kind === Invitation::INVITE ? (int) config('prime.invitation_hours', 72) : (int) config('prime.password_reset_hours', 24);
+        $link = new Invitation;
+        $link->forceFill([
+            'membership_id' => $membership->id,
+            'user_id' => $membership->user_id,
+            'kind' => $kind,
+            'token_hash' => Invitation::hashToken($token),
+            'expires_at' => now()->addHours($hours),
+            'created_by' => $by->id,
+        ])->save();
+
+        return route('erp.invitation', ['token' => $token]);
+    }
+
+    private function revokeLinks(Membership $membership): void
+    {
+        Invitation::query()->where('membership_id', $membership->id)->whereNull('used_at')->whereNull('revoked_at')
+            ->update(['revoked_at' => now()]);
+    }
+
+    private function assignRole(User $user, Role $role): void
+    {
+        $user->unsetRelation('roles');
+        $user->syncRoles([$role]);
+        app(PermissionRegistrar::class)->forgetCachedPermissions();
+        Access::instance()->flush();
+    }
+
+    /** The role must be of this firm; only an owner hands out the owner role (TZ 03 §2 p.2). */
+    private function role(int $roleId, User $by): Role
+    {
+        $role = Role::query()->where('organization_id', CurrentOrganization::instance()->requireId())->whereKey($roleId)->first();
+        if (! $role) {
+            throw UserFacingException::because('role', __('Выберите роль'));
+        }
+        if ($role->is_owner && ! Access::isOwner($by)) {
+            throw AccessDenied::because('access_denied', __('Роль «Владелец» назначает только владелец'));
+        }
+
+        return $role;
+    }
+
+    /** @return list<int> */
+    private function stores(array $ids): array
+    {
+        $ids = array_values(array_unique(array_map('intval', array_filter($ids))));
+        if ($ids === []) {
+            throw UserFacingException::because('stores', __('Отметьте хотя бы один магазин'));
+        }
+        $found = Store::query()->whereKey($ids)->pluck('id')->all();
+        if (count($found) !== count($ids)) {
+            throw UserFacingException::because('stores', __('Магазин не найден в этой фирме'));
+        }
+
+        return $ids;
+    }
+
+    private function flags(array $storeIds, array $flags): array
+    {
+        $out = [];
+        foreach ($storeIds as $id) {
+            $f = $flags[$id] ?? $flags[(string) $id] ?? [];
+            $out[(string) $id] = ['sales' => (bool) ($f['sales'] ?? true), 'finance' => (bool) ($f['finance'] ?? true)];
+        }
+
+        return $out;
+    }
+
+    /** Personal limits: only known codes; '' = remove (as the role), 'inf' = ∞ (null). */
+    private function limits(array $limits): array
+    {
+        $out = [];
+        foreach ($limits as $code => $value) {
+            $limit = Limit::tryFrom((string) $code);
+            if (! $limit || $value === '' || $value === null) {
+                continue;
+            }
+            $out[$limit->value] = $value === 'inf' ? null : max(0, (int) $value);
+        }
+
+        return $out;
+    }
+
+    private function payroll(array $payroll): array
+    {
+        $out = [];
+        foreach (['phones', 'accessories'] as $key) {
+            $v = $payroll[$key] ?? null;
+            if ($v === null || $v === '') {
+                continue;
+            }
+            $v = str_replace(',', '.', (string) $v);
+            if (! is_numeric($v) || (float) $v < 0 || (float) $v > 50) {
+                throw UserFacingException::because('payroll', __('Процент продавцу — от 0 до 50 %'));
+            }
+            $out[$key] = number_format((float) $v, 2, '.', '');
+        }
+
+        return $out;
+    }
+
+    private function phone(string $raw): string
+    {
+        try {
+            return Phone::normalize($raw);
+        } catch (InvalidArgumentException) {
+            throw UserFacingException::because('phone', __('Введите номер полностью: 10 цифр после +7'));
+        }
+    }
+
+    private function assertNotSelf(Membership $membership, User $by): void
+    {
+        if ($membership->user_id === $by->id) {
+            throw UserFacingException::because('self', __('Себя заблокировать или уволить нельзя'));
+        }
+    }
+
+    /** There is always at least one active owner (TZ 03 §2 p.1). */
+    private function assertNotLastOwner(Membership $membership): void
+    {
+        $role = $this->roleOf($membership->user);
+        if (! $role?->is_owner) {
+            return;
+        }
+        $owners = Membership::query()->where('status', MembershipStatus::Active->value)->where('id', '!=', $membership->id)->get()
+            ->filter(fn (Membership $m) => (bool) $this->roleOf($m->user)?->is_owner);
+        if ($owners->isEmpty()) {
+            throw UserFacingException::because('last_owner', __('Это последний владелец фирмы — его нельзя заблокировать, уволить или сменить ему роль'));
+        }
+    }
+
+    private function snapshot(Membership $m): array
+    {
+        return [
+            'role' => $this->roleOf($m->user)?->title,
+            'stores' => $m->store_ids,
+            'limits' => $m->limits,
+            'payroll' => $m->payroll,
+        ];
+    }
+}
