+import preset from '../../../../vendor/filament/filament/tailwind.config.preset'
+
+/*
+ * Theme of the ERP panel (module «shell»). Filament preset + Prime Mobile tokens (../../tokens.css):
+ * bg-background, text-muted-foreground, border-border, bg-primary (accent), text-ok / warn / bad …
+ * Filament shades (bg-primary-600, text-gray-500) keep working — the accent fills both.
+ * No color-mix / oklch / container queries: Chrome 109 (Windows 7) must render everything.
+ */
+const v = (name) => `rgb(var(--${name}) / <alpha-value>)`
+
+export default {
+    presets: [preset],
+    darkMode: 'class',
+    content: [
+        './app/Filament/**/*.php',
+        './app/Livewire/**/*.php',
+        './app/Support/Ui/**/*.php',
+        './app/Domain/**/Enums/*.php',
+        './resources/views/**/*.blade.php',
+        './resources/js/**/*.js',
+        './vendor/filament/**/*.blade.php',
+    ],
+    theme: {
+        extend: {
+            fontFamily: {
+                sans: ['Onest', 'Segoe UI', 'Arial', 'sans-serif'],
+                mono: ['"JetBrains Mono"', 'Consolas', 'monospace'],
+            },
+            colors: {
+                background: v('background'),
+                foreground: v('foreground'),
+                card: v('card'),
+                primary: { DEFAULT: v('primary'), foreground: v('primary-foreground') },
+                muted: { DEFAULT: v('muted'), foreground: v('muted-foreground') },
+                border: v('border'),
+                input: v('input'),
+                ring: v('ring'),
+                ok: v('ok'),
+                warn: v('warn'),
+                bad: v('bad'),
+                photo: v('photo'),
+                'store-a': v('store-a'),
+                'store-b': v('store-b'),
+            },
+            screens: {
+                // TZ 04 §0.1: ≥ 1280 menu expanded, 1024–1279 icons, < 1024 iPhone layout.
+                desk: '1024px',
+                wide: '1280px',
+                hd: '1440px',
+            },
+        },
+    },
+}
diff --git a/prime-mobile-os/resources/css/filament/admin/theme.css b/prime-mobile-os/resources/css/filament/admin/theme.css
new file mode 100644
index 0000000..b4b6186
--- /dev/null
+++ b/prime-mobile-os/resources/css/filament/admin/theme.css
@@ -0,0 +1,118 @@
+@import '/vendor/filament/filament/resources/css/theme.css';
+@import '../../fonts.css';
+@import '../../tokens.css';
+
+@config 'tailwind.config.js';
+
+/*
+ * ERP theme (module «shell»): Filament restyled to the Prime Mobile mockups
+ * (docs/design/screens/erp-*.png, src/erp.py). Rules:
+ *  - only CSS that Chrome 109 understands (no :has in critical places, no color-mix, no nesting);
+ *  - colors come from tokens (rgb(var(--x))) or Filament shades (rgba(var(--primary-600), a));
+ *  - iPhone (< 1024 px): fields 16 px (Safari does not zoom), touch targets ≥ 44 px, safe areas.
+ */
+
+html { -webkit-text-size-adjust: 100%; }
+body.fi-body { background-color: rgb(var(--background)); color: rgb(var(--foreground)); -webkit-font-smoothing: antialiased; }
+.dark body.fi-body { background-color: rgb(var(--background)); }
+span, a, button, th { -webkit-tap-highlight-color: transparent; }
+.font-mono, .pm-imei { font-feature-settings: 'zero' 0; letter-spacing: 0; }
+
+/* ---------------------------------------------------------------- page header: eyebrow above the title */
+.fi-header > div:first-child { display: flex; flex-direction: column-reverse; gap: 2px; }
+.fi-header-heading { font-size: 24px !important; line-height: 1.2 !important; font-weight: 600 !important; letter-spacing: -0.02em; }
+.fi-header-subheading { font-size: 13px !important; margin-top: 0 !important; color: rgb(var(--muted-foreground)) !important; }
+.fi-page > section { row-gap: 1.25rem; }
+
+/* ---------------------------------------------------------------- cards, sections, tables */
+.fi-section, .fi-ta-ctn, .fi-wi-stats-overview-stat, .fi-fo-repeater-item, .fi-in-section {
+  box-shadow: none !important; border-radius: 12px !important;
+  --tw-ring-color: rgb(var(--border)) !important; background-color: rgb(var(--card)) !important;
+}
+.fi-section-header-heading { font-size: 15px; font-weight: 600; }
+.fi-section-header-description { font-size: 12.5px; }
+.fi-ta-header-cell { font-size: 12.5px; font-weight: 500; color: rgb(var(--muted-foreground)); }
+.fi-ta-header-cell-label { font-weight: 500 !important; }
+.fi-ta-row > td { height: 44px; }
+.fi-ta-row { border-color: rgb(var(--border)) !important; }
+.fi-ta-text-item-label { font-size: 13.5px; }
+
+/* ---------------------------------------------------------------- buttons and fields */
+.fi-btn { border-radius: 8px !important; font-weight: 500 !important; }
+.fi-btn-size-md { min-height: 36px; font-size: 13.5px !important; }
+.fi-btn-size-lg, .fi-btn-size-xl { min-height: 44px; }
+.fi-btn-color-gray { box-shadow: none !important; --tw-ring-color: rgb(var(--border)) !important; }
+.fi-input-wrp { border-radius: 8px !important; box-shadow: none !important; --tw-ring-color: rgb(var(--input)) !important; background-color: rgb(var(--card)) !important; }
+.fi-input-wrp:focus-within { --tw-ring-color: rgb(var(--ring)) !important; }
+.fi-input, .fi-select-input { font-size: 14px; }
+.fi-fo-field-wrp-label > span { font-size: 13px; font-weight: 500; }
+.fi-fo-field-wrp-hint, .fi-fo-field-wrp-helper-text { font-size: 12.5px; }
+.fi-tabs { box-shadow: none !important; background: transparent !important; --tw-ring-color: transparent !important; border-bottom: 1px solid rgb(var(--border)); border-radius: 0 !important; padding: 0 !important; gap: 24px !important; }
+.fi-tabs-item { border-radius: 0 !important; padding: 10px 0 !important; position: relative; background: transparent !important; }
+.fi-tabs-item.fi-active::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; border-radius: 2px; background: rgb(var(--primary)); }
+.fi-tabs-item-label { font-size: 13.5px; }
+.fi-badge { border-radius: 6px !important; font-weight: 500; }
+
+/* Dark graphite: accent buttons are near-white with dark text (mockup erp-2-prodazha-temnaya.png). */
+.dark.accent-graphite .fi-btn.fi-color-primary, .dark.accent-graphite .fi-btn-color-primary {
+  background-color: rgb(var(--primary)) !important; color: rgb(var(--primary-foreground)) !important; }
+.dark.accent-graphite .fi-btn.fi-color-primary .fi-btn-icon { color: rgb(var(--primary-foreground)) !important; }
+
+/* ---------------------------------------------------------------- modals: on iPhone a bottom sheet (TZ 04 §0.3 п. 7) */
+@media (max-width: 1023px) {
+  .fi-modal-window-ctn { align-items: flex-end !important; padding: 0 !important; }
+  .fi-modal-window { max-width: 100% !important; border-radius: 20px 20px 0 0 !important; margin: 0 !important;
+    padding-bottom: env(safe-area-inset-bottom); }
+  .fi-modal-window.fi-modal-slide-over-window { border-radius: 0 !important; }
+  .fi-no { top: env(safe-area-inset-top) !important; bottom: auto !important; }
+}
+
+/* ---------------------------------------------------------------- iPhone: no zoom on focus, big targets */
+@media (max-width: 1023px) {
+  input, select, textarea, .fi-input, .fi-select-input { font-size: 16px !important; }
+  .fi-btn-size-md, .fi-btn-size-sm { min-height: 44px; }
+  .fi-main, .pm-main { overflow-x: hidden; }
+  .fi-header-heading { font-size: 28px !important; }
+  .fi-ta-ctn { border-radius: 14px !important; }
+}
+
+/* ---------------------------------------------------------------- shell frame (layout: resources/views/vendor/filament-panels/components/layout/index.blade.php) */
+.pm-sidebar { width: 236px; }
+@media (min-width: 1024px) and (max-width: 1279px) { .pm-sidebar { width: 64px; } }
+.pm-sidebar-link { display: flex; align-items: center; gap: 10px; height: 36px; padding: 0 10px; border-radius: 8px;
+  font-size: 13.5px; font-weight: 500; color: rgb(var(--muted-foreground)); transition: color .15s, background-color .15s; }
+.pm-sidebar-link:hover { color: rgb(var(--foreground)); background-color: rgb(var(--muted)); }
+.pm-sidebar-link.is-active { color: rgb(var(--foreground)); background-color: rgb(var(--card)); box-shadow: 0 0 0 1px rgb(var(--border)); }
+.legacy .pm-sidebar-link.is-active { outline: 1px solid rgb(var(--border)); }
+.pm-tabbar { padding-bottom: env(safe-area-inset-bottom); }
+.pm-mobile-header { padding-top: env(safe-area-inset-top); }
+.pm-safe-x { padding-left: max(16px, env(safe-area-inset-left)); padding-right: max(16px, env(safe-area-inset-right)); }
+@media (min-width: 1024px) { .pm-safe-x { padding-left: 24px; padding-right: 24px; } }
+@media (min-width: 1440px) { .pm-safe-x { padding-left: 32px; padding-right: 32px; } }
+.pm-scroll-x { overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
+.pm-scroll-x::-webkit-scrollbar { display: none; }
+
+/* Global search in the topbar looks like the mockup: 380 px, icon, «/» hint. */
+.pm-topbar .fi-global-search-field { width: 380px; }
+.pm-topbar .fi-global-search-field .fi-input-wrp { height: 40px; }
+.pm-topbar .fi-global-search-results-ctn { width: 480px; }
+
+/* Toggle in our components */
+.pm-switch { position: relative; display: inline-block; width: 36px; height: 20px; border-radius: 9999px; background: rgb(var(--input)); transition: background-color .15s; flex-shrink: 0; }
+.pm-switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 9999px; background: rgb(var(--card)); box-shadow: 0 1px 2px rgba(0,0,0,.2); transition: left .15s; }
+.pm-switch.is-on { background: rgb(var(--primary)); }
+.pm-switch.is-on::after { left: 18px; }
+@media (max-width: 1023px) { .pm-switch { width: 44px; height: 26px; } .pm-switch::after { width: 22px; height: 22px; } .pm-switch.is-on::after { left: 20px; } }
+
+/* Scan field flash (TZ 04 §0.4 п. 10): green on success, red frame on error */
+.pm-flash-ok { animation: pm-flash-ok .6s ease-out; }
+.pm-flash-bad { border-color: rgb(var(--bad)) !important; animation: pm-shake .3s; }
+@keyframes pm-flash-ok { 0% { background-color: rgb(var(--ok) / .18); } 100% { background-color: rgb(var(--card)); } }
+@keyframes pm-shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
+
+/* Lock overlay: blurred page; in «старый ноутбук» simply white (TZ 04 Э1.3) */
+.pm-lock-backdrop { background: rgb(var(--background) / .72); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
+.legacy .pm-lock-backdrop { background: rgb(var(--background)); }
+
+/* Printing: only the document */
+@media print { .pm-sidebar, .pm-topbar, .pm-tabbar, .pm-mobile-header, .fi-no { display: none !important; } }
diff --git a/prime-mobile-os/resources/css/fonts.css b/prime-mobile-os/resources/css/fonts.css
