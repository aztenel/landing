index 0000000..3d784a4
--- /dev/null
+++ b/prime-mobile-os/resources/css/fonts.css
@@ -0,0 +1,23 @@
+/*
+ * Onest (text, has Kazakh letters and ₸) and JetBrains Mono (IMEI) — self-hosted, variable weight.
+ * No Google Fonts at runtime: the store laptop and the iPhones work even if Google is slow or blocked.
+ * Subsets as Google Fonts slices them (latin-ext carries ₸ U+20B8, cyrillic-ext — ә ғ қ ң ө ұ ү һ і).
+ */
+@font-face { font-family: 'Onest'; font-style: normal; font-weight: 400 700; font-display: swap;
+  src: url('../fonts/onest-cyrillic-ext.woff2') format('woff2');
+  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F; }
+@font-face { font-family: 'Onest'; font-style: normal; font-weight: 400 700; font-display: swap;
+  src: url('../fonts/onest-cyrillic.woff2') format('woff2');
+  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116; }
+@font-face { font-family: 'Onest'; font-style: normal; font-weight: 400 700; font-display: swap;
+  src: url('../fonts/onest-latin-ext.woff2') format('woff2');
+  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
+@font-face { font-family: 'Onest'; font-style: normal; font-weight: 400 700; font-display: swap;
+  src: url('../fonts/onest-latin.woff2') format('woff2');
+  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
+@font-face { font-family: 'JetBrains Mono'; font-style: normal; font-weight: 400 500; font-display: swap;
+  src: url('../fonts/jetbrains-mono-cyrillic.woff2') format('woff2');
+  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116; }
+@font-face { font-family: 'JetBrains Mono'; font-style: normal; font-weight: 400 500; font-display: swap;
+  src: url('../fonts/jetbrains-mono-latin.woff2') format('woff2');
+  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
diff --git a/prime-mobile-os/resources/css/tokens.css b/prime-mobile-os/resources/css/tokens.css
index 09efaec..b6c7cdb 100644
--- a/prime-mobile-os/resources/css/tokens.css
+++ b/prime-mobile-os/resources/css/tokens.css
@@ -1,22 +1,44 @@
-/* Prime Mobile tokens — RGB channels. Accent blue by default; graphite is a firm setting. */
+/* Prime Mobile tokens — RGB channels (rgb(var(--x) / a) works in Chrome 109; no color-mix/oklch).
+ * Accent blue by default; the firm accent (graphite, …) is set by the shell as `accent-<name>` on <html>
+ * plus an inline style with the same variables (App\Support\Ui\Accent::css()). */
 :root {
   --background: 250 250 250; --foreground: 17 17 19; --card: 255 255 255;
   --primary: 42 75 215; --primary-foreground: 255 255 255;
   --muted: 244 244 245; --muted-foreground: 110 110 118;
   --border: 230 230 233; --input: 217 217 222; --ring: 42 75 215;
   --ok: 21 127 61; --warn: 165 90 8; --bad: 200 38 31; --photo: 244 244 245;
+  --store-a: 42 75 215; --store-b: 180 180 188;
+  --logo-1: 58 58 64; --logo-2: 140 140 148; --logo-3: 17 17 19;
 }
-.accent-graphite { --primary: 24 24 27; --ring: 24 24 27; --primary-foreground: 250 250 250; }
+.accent-graphite { --primary: 24 24 27; --ring: 24 24 27; --primary-foreground: 250 250 250; --store-a: 24 24 27; }
 .dark {
   --background: 11 11 13; --foreground: 242 242 243; --card: 20 20 23;
   --primary: 110 138 255; --primary-foreground: 255 255 255;
   --muted: 29 29 33; --muted-foreground: 154 154 163;
   --border: 38 38 43; --input: 51 51 58; --ring: 110 138 255;
   --ok: 74 222 128; --warn: 245 181 68; --bad: 248 113 113; --photo: 237 237 239;
+  --store-a: 110 138 255; --store-b: 92 92 100;
+  --logo-1: 250 251 252; --logo-2: 174 178 184; --logo-3: 233 234 236;
 }
-.dark.accent-graphite { --primary: 242 242 243; --primary-foreground: 17 17 19; --ring: 242 242 243; }
-/* Old laptop mode (Windows 7, weak screen): bigger small text, darker grey, contrast borders, no effects. */
-.legacy { --muted-foreground: 74 74 82; --border: 200 200 208; --input: 180 180 189; }
-.legacy .text-xs, .legacy .text-\[11px\], .legacy .text-\[12px\] { font-size: 13px !important; }
-.legacy * { box-shadow: none !important; transition: none !important; animation: none !important; }
+.dark.accent-graphite { --primary: 242 242 243; --primary-foreground: 17 17 19; --ring: 242 242 243; --store-a: 232 232 234; }
+
+/* «Старый ноутбук» (TZ 04 Э29): text ≥ 13 px (main 15 px), darker grey (≥ 7:1), contrast borders,
+ * no shadows / transparency / blur / animations, rows 48 px. Same layout — only this class on <html>. */
+.legacy { --muted-foreground: 74 74 82; --border: 200 200 208; --input: 180 180 189; --store-b: 154 154 163;
+  --gray-400: 113, 113, 122; --gray-500: 74, 74, 82; --gray-600: 63, 63, 70; }
+.dark.legacy { --muted-foreground: 196 196 204; --border: 70 70 78; --input: 90 90 100;
+  --gray-400: 196, 196, 204; --gray-500: 196, 196, 204; }
+.legacy body { font-size: 15px; }
+.legacy .text-xs, .legacy .text-\[10px\], .legacy .text-\[11px\], .legacy .text-\[11\.5px\], .legacy .text-\[12px\] { font-size: 13px !important; }
+.legacy .text-sm, .legacy .text-\[12\.5px\], .legacy .text-\[13px\] { font-size: 13.5px !important; }
+.legacy .text-\[13\.5px\] { font-size: 14.5px !important; }
+.legacy *, .legacy *::before, .legacy *::after { box-shadow: none !important; transition: none !important; animation: none !important;
+  -webkit-backdrop-filter: none !important; backdrop-filter: none !important; text-shadow: none !important; }
+.legacy .text-muted-foreground { font-weight: 500; }
+.legacy .ring-2 { outline: 2.5px solid rgb(var(--primary)); outline-offset: -1px; }
+.legacy [class*="ring-gray-950\/5"], .legacy [class*="ring-gray-950\/10"] { --tw-ring-color: rgba(63, 63, 70, .35) !important; }
+.legacy [class*="bg-gray-950\/50"], .legacy [class*="bg-black\/"] { background-color: rgb(var(--background)) !important; }
+.legacy .fi-ta-row > td, .legacy .pm-row { height: 48px; }
+.legacy .fi-ta-text, .legacy .fi-ta-text-item-label { font-size: 14px !important; }
+
 .num { font-variant-numeric: tabular-nums; }
