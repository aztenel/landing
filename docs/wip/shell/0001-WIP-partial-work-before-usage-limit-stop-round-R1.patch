@@ -0,0 +1,65 @@
+<?php
+
+namespace App\Support\Routing;
+
+use Closure;
+use Filament\Facades\Filament;
+use Illuminate\Support\Facades\Route;
+
+/**
+ * Route groups for modules (one system, two addresses — TZ 05 §1). A module keeps its routes in
+ * routes/modules/<slug>.php; the file is required by routes/web.php (ModuleRoutes::load()).
+ *
+ *   ModuleRoutes::erp(function () {            // erp.<domain>, logged in, firm context, device/lock checks
+ *       Route::get('/unit/{code}', UnitPassport::class)->name('unit');   // route('erp.unit', …)
+ *   });
+ *   ModuleRoutes::erpGuest(fn () => …);         // erp.<domain>, no login (invitation links, webhooks)
+ *   ModuleRoutes::storefront(fn () => …);       // <domain> — the public site, name prefix «storefront.»
+ *
+ * Filament pages/resources do NOT need routes here: they are discovered from app/Filament/<Module>/….
+ */
+final class ModuleRoutes
+{
+    public static function load(): void
+    {
+        foreach (glob(base_path('routes/modules/*.php')) ?: [] as $file) {
+            require $file;
+        }
+    }
+
+    public static function erp(Closure $routes, string $name = 'erp.'): void
+    {
+        $panel = Filament::getPanel('admin');
+
+        Route::domain(self::erpDomain())
+            ->middleware([...$panel->getMiddleware(), ...$panel->getAuthMiddleware()])
+            ->name($name)
+            ->group($routes);
+    }
+
+    public static function erpGuest(Closure $routes): void
+    {
+        Route::domain(self::erpDomain())
+            ->middleware(Filament::getPanel('admin')->getMiddleware())
+            ->name('erp.')
+            ->group($routes);
+    }
+
+    public static function storefront(Closure $routes): void
+    {
+        Route::domain(self::shopDomain())
+            ->middleware('web')
+            ->name('storefront.')
+            ->group($routes);
+    }
+
+    public static function erpDomain(): ?string
+    {
+        return config('prime.erp_domain') ?: null;
+    }
+
+    public static function shopDomain(): ?string
+    {
+        return config('prime.shop_domain') ?: null;
+    }
+}
diff --git a/prime-mobile-os/app/Support/Ui/Accent.php b/prime-mobile-os/app/Support/Ui/Accent.php
new file mode 100644
index 0000000..ec9e80f
--- /dev/null
+++ b/prime-mobile-os/app/Support/Ui/Accent.php
@@ -0,0 +1,132 @@
+<?php
+
+namespace App\Support\Ui;
+
+/**
+ * Accent color of the organization (TZ 04 Э26 «Бренд»; architecture 1а). Blue is the default, graphite the
+ * second approved variant; four more contrast-checked variants (Допущение Э26: «+ 4 варианта»).
+ *
+ * The accent is applied twice: our tokens (--primary, --ring, …; resources/css/tokens.css) and the Filament
+ * primary palette (--primary-50…950). Both are rendered into <head> by the shell and the class
+ * `accent-<value>` is put on <html>.
+ */
+enum Accent: string
+{
+    case Blue = 'blue';
+    case Graphite = 'graphite';
+    case Navy = 'navy';
+    case Teal = 'teal';
+    case Violet = 'violet';
+    case Plum = 'plum';
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::Blue => __('Синий'),
+            self::Graphite => __('Графит'),
+            self::Navy => __('Тёмно-синий'),
+            self::Teal => __('Морская волна'),
+            self::Violet => __('Фиолетовый'),
+            self::Plum => __('Сливовый'),
+        };
+    }
+
+    /** Main accent (button background) in light mode. */
+    public function hex(): string
+    {
+        return match ($this) {
+            self::Blue => '#2A4BD7',
+            self::Graphite => '#18181B',
+            self::Navy => '#1E3A8A',
+            self::Teal => '#0B6E79',
+            self::Violet => '#5B3FD9',
+            self::Plum => '#8A2C6F',
+        };
+    }
+
+    /** Accent in dark mode (lighter; graphite becomes near-white with dark text, as on the dark mockup). */
+    public function darkHex(): string
+    {
+        return match ($this) {
+            self::Blue => '#6E8AFF',
+            self::Graphite => '#F2F2F3',
+            self::Navy => '#7C9CF0',
+            self::Teal => '#4FB6C1',
+            self::Violet => '#9A86F5',
+            self::Plum => '#D178B4',
+        };
+    }
+
+    public function darkForeground(): string
+    {
+        return $this === self::Graphite ? '#111113' : '#FFFFFF';
+    }
+
+    public static function fromSetting(?string $value): self
+    {
+        return self::tryFrom((string) $value) ?? self::Blue;
+    }
+
+    /** @return list<string> */
+    public static function values(): array
+    {
+        return array_map(fn (self $a) => $a->value, self::cases());
+    }
+
+    /** "42 75 215" — RGB channels for rgb(var(--x) / a) tokens. */
+    public static function channels(string $hex): string
+    {
+        return implode(' ', self::rgb($hex));
+    }
+
+    /**
+     * Filament palette (50…950) with the accent at 600 (Filament buttons use 600, hover 500).
+     *
+     * @return array<int, string> shade => "r, g, b"
+     */
+    public function filamentPalette(): array
+    {
+        if ($this === self::Graphite) {
+            return [
+                50 => '250, 250, 250', 100 => '244, 244, 245', 200 => '228, 228, 231', 300 => '212, 212, 216',
+                400 => '161, 161, 170', 500 => '82, 82, 91', 600 => '24, 24, 27', 700 => '17, 17, 19',
+                800 => '12, 12, 14', 900 => '9, 9, 11', 950 => '5, 5, 6',
+            ];
+        }
+        $base = self::rgb($this->hex());
+        $mix = fn (array $to, float $t) => implode(', ', array_map(
+            fn ($c, $o) => (int) round($c + ($o - $c) * $t), $base, $to));
+        $white = [255, 255, 255];
+        $black = [0, 0, 0];
+
+        return [
+            50 => $mix($white, 0.94), 100 => $mix($white, 0.88), 200 => $mix($white, 0.75), 300 => $mix($white, 0.56),
+            400 => $mix($white, 0.32), 500 => $mix($white, 0.14), 600 => $mix($white, 0.0), 700 => $mix($black, 0.14),
+            800 => $mix($black, 0.28), 900 => $mix($black, 0.42), 950 => $mix($black, 0.58),
+        ];
+    }
+
+    /** Inline CSS (tokens + Filament palette) for <head>. `html.accent-x` beats Filament's own `:root` palette. */
+    public function css(): string
+    {
+        $vars = '';
+        foreach ($this->filamentPalette() as $shade => $rgb) {
+            $vars .= "--primary-{$shade}:{$rgb};";
+        }
+        $light = self::channels($this->hex());
+        $dark = self::channels($this->darkHex());
+        $darkFg = self::channels($this->darkForeground());
+        $class = 'accent-'.$this->value;
+
+        return "html.{$class}{{$vars}--primary:{$light};--ring:{$light};--store-a:{$light};--primary-foreground:255 255 255}"
+            ."html.dark.{$class}{--primary:{$dark};--ring:{$dark};--store-a:{$dark};--primary-foreground:{$darkFg}}";
+    }
+
+    /** @return array{0:int,1:int,2:int} */
+    private static function rgb(string $hex): array
+    {
+        $hex = ltrim($hex, '#');
+
+        return [(int) hexdec(substr($hex, 0, 2)), (int) hexdec(substr($hex, 2, 2)), (int) hexdec(substr($hex, 4, 2))];
+    }
+}
diff --git a/prime-mobile-os/app/Support/Ui/Access.php b/prime-mobile-os/app/Support/Ui/Access.php
new file mode 100644
index 0000000..c753cb0
--- /dev/null
+++ b/prime-mobile-os/app/Support/Ui/Access.php
@@ -0,0 +1,114 @@
+<?php
+
+namespace App\Support\Ui;
+
+use App\Domain\Tenancy\Access\AccessChecker;
+use App\Domain\Tenancy\Access\AccessDecision;
+use App\Domain\Tenancy\Access\Exceptions\AccessDenied;
+use App\Domain\Tenancy\Access\Exceptions\ApprovalRequired;
+use App\Domain\Tenancy\Access\Limit;
+use App\Models\User;
+use App\Support\Tenancy\CurrentOrganization;
+use Illuminate\Support\Facades\Auth;
+
+/**
+ * Screen-level access (TZ 03 §18 p.1–2) on top of AccessChecker, cached for the current request.
+ *
+ *   Access::sees('stock.view_cost')        — show the menu item / column / button (right exists, maybe «only via approval»)
+ *   Access::allows('rate.set')             — may do it right now without approval
+ *   Access::authorize('org.settings')      — server-side guard in a Livewire/Filament action: AccessDenied / ApprovalRequired
+ *
+ * A permission argument may be a list: the user needs ANY of them. Membership status, store scope and the
+ * firm context are taken into account (AccessChecker); no context or no user → nothing is visible.
+ */
+final class Access
+{
+    /** @var array<string, AccessDecision> */
+    private array $cache = [];
+
+    public function __construct(private readonly AccessChecker $checker) {}
+
+    public static function instance(): self
+    {
+        return app(self::class);
+    }
+
+    /** @param string|list<string>|null $permission */
+    public static function sees(string|array|null $permission, ?User $user = null): bool
+    {
+        if ($permission === null) {
+            return self::instance()->member($user);
+        }
+        foreach ((array) $permission as $code) {
+            if (! self::instance()->decision($code, $user)->isDenied()) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    /** @param string|list<string> $permission */
+    public static function allows(string|array $permission, ?User $user = null): bool
+    {
+        foreach ((array) $permission as $code) {
+            if (self::instance()->decision($code, $user)->isAllowed()) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    public static function isOwner(?User $user = null): bool
+    {
+        $user ??= Auth::user();
+
+        return $user instanceof User && CurrentOrganization::instance()->has() && app(AccessChecker::class)->isOwner($user);
+    }
+
+    /**
+     * Server-side check for an action. Denied → AccessDenied («Нет права: …» or $message);
+     * «only via approval» / over the limit → ApprovalRequired (the Approvals module turns it into a request).
+     */
+    public static function authorize(string $permission, ?string $message = null, ?Limit $limit = null, ?int $value = null, ?User $user = null): void
+    {
+        $user ??= Auth::user();
+        if (! $user instanceof User || ! CurrentOrganization::instance()->has()) {
+            throw AccessDenied::because('access_denied', __('Доступ закрыт. Обратитесь к владельцу'));
+        }
+        $decision = app(AccessChecker::class)->decide($user, $permission, $limit, $value);
+        if ($decision->isDenied()) {
+            throw AccessDenied::because('access_denied', $message ?? $decision->message);
+        }
+        if ($decision->needsApproval()) {
+            throw new ApprovalRequired($decision, $permission);
+        }
+    }
+
+    public function decision(string $permission, ?User $user = null): AccessDecision
+    {
+        $user ??= Auth::user();
+        $org = CurrentOrganization::instance()->id();
+        if (! $user instanceof User || $org === null) {
+            return AccessDecision::denied($permission, __('Доступ закрыт. Обратитесь к владельцу'));
+        }
+        $key = $org.':'.$user->getKey().':'.$permission;
+
+        return $this->cache[$key] ??= $this->checker->decide($user, $permission);
+    }
+
+    /** Forget cached answers (after a role/membership change inside the same request). */
+    public function flush(): void
+    {
+        $this->cache = [];
+    }
+
+    private function member(?User $user): bool
+    {
+        $user ??= Auth::user();
+        $org = CurrentOrganization::instance()->id();
+
+        return $user instanceof User && $org !== null && $user->hasActiveMembershipIn($org);
+    }
+}
