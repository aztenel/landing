# Production .env — values are filled ON THE SERVER only (/var/www/prime/shared/.env, chmod 600). No secrets in git.
APP_NAME="Prime Mobile"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://erp.primemobile.kz
APP_KEY=                      # php artisan key:generate --show

PRIME_ERP_DOMAIN=erp.primemobile.kz
PRIME_SHOP_DOMAIN=primemobile.kz
BLIND_INDEX_KEY=              # long random string, different from APP_KEY (IIN blind index)

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=prime
DB_USERNAME=prime
DB_PASSWORD=
DB_SITE_USERNAME=prime_site   # deploy/postgres/site_role.sql
DB_SITE_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1

SFON_API_KEY=                 # only for the migration, removed after sfon is switched off
TELEGRAM_BOT_TOKEN=
